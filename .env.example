# Production URLs
# Frontend: https://thegreatindianews.netlify.app
# Backend:  https://news-backend-pxp9.onrender.com

PORT=5000
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/great-india-news?retryWrites=true&w=majority
JWT_SECRET=change-this-secret-key
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Comma-separated — your Netlify URL + localhost for local dev
CLIENT_URL=https://thegreatindianews.netlify.app,http://localhost:5173
# Gemini AI (AEO/GEO generation) — keep secret; never commit real keys
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Astrology API (optional env override — never expose to frontend)
# ASTROLOGY_API_PROVIDER=astrologyapi
# ASTROLOGY_API_BASE_URL=https://json.astrologyapi.com
# ASTROLOGY_API_KEY=
# ASTROLOGY_API_SECRET=

# Optional — YouTube slider uses free RSS by default (no key needed)
# YOUTUBE_API_KEY=

# Instagram / Meta (official oEmbed + optional Graph enrichment)
# Create an app at https://developers.facebook.com/ — enable Instagram oEmbed Read
INSTAGRAM_ACCESS_TOKEN=
# Or use app credentials (app token = APP_ID|APP_SECRET works for oEmbed):
# META_APP_ID=
# META_APP_SECRET=
# Optional: IG Business account ID to enrich carousels for YOUR posts only
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
